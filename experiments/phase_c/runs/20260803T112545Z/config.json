{
  "phase": "C",
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "hcrl": {
    "data_dir": "data",
    "datasets": [
      "DoS",
      "Fuzzy",
      "RPM",
      "gear"
    ],
    "sample_size": 60000,
    "window_size": 30,
    "split": {
      "calib_frac": 0.4,
      "train_frac": 0.2,
      "test_frac": 0.4
    }
  },
  "road": {
    "data_dir": "road/road",
    "window_size": 30,
    "max_frames_per_capture": 80000,
    "capture_sample": {
      "per_type": 1,
      "skip_masquerade": true,
      "skip_unlabeled": true
    }
  },
  "evaluation": {
    "val_holdout_fraction": 0.2,
    "fpr_target": 0.01
  },
  "detectors": [
    "isolation_forest",
    "one_class_svm",
    "lof",
    "hbos",
    "elliptic_envelope",
    "autoencoder"
  ],
  "detector_params": {
    "isolation_forest": {
      "n_estimators": 200,
      "n_jobs": 1
    },
    "one_class_svm": {
      "nu": 0.05,
      "max_train_samples": 4000
    },
    "lof": {
      "n_neighbors": 20,
      "max_train_samples": 6000,
      "n_jobs": 1
    },
    "hbos": {
      "n_bins": 10
    },
    "elliptic_envelope": {
      "contamination": 0.05,
      "max_train_samples": 6000
    },
    "autoencoder": {
      "hidden_layer_sizes": [
        8,
        4,
        8
      ],
      "max_iter": 80,
      "max_train_samples": 6000
    }
  },
  "bootstrap": {
    "n_boot": 200,
    "block_size": 50,
    "ci": 0.95
  },
  "importance": {
    "detector": "isolation_forest",
    "n_repeats": 5,
    "hcrl_datasets": [
      "RPM",
      "gear"
    ],
    "road_captures": [
      "correlated_signal_attack_1",
      "reverse_light_off_attack_1"
    ]
  },
  "representations": [
    "raw",
    "residual"
  ],
  "cache_dir": ".cache/phase_c",
  "output_dir": "experiments",
  "tables_dir": "tables",
  "figures_dir": "figures"
}