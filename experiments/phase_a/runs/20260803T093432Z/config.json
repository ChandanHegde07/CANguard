{
  "phase": "A",
  "seed": 0,
  "dataset": "hcrl",
  "data_dir": "data",
  "datasets": [
    "DoS",
    "Fuzzy",
    "RPM",
    "gear"
  ],
  "sample_size": 60000,
  "window_size": 30,
  "split": {
    "calib_frac": 0.4,
    "train_frac": 0.2,
    "test_frac": 0.4
  },
  "evaluation": {
    "val_holdout_fraction": 0.2,
    "fpr_target": 0.01
  },
  "detectors": [
    "isolation_forest",
    "one_class_svm",
    "lof",
    "hbos",
    "elliptic_envelope",
    "autoencoder"
  ],
  "detector_params": {
    "isolation_forest": {
      "n_estimators": 200,
      "n_jobs": 1,
      "random_state": 0
    },
    "one_class_svm": {
      "nu": 0.05,
      "max_train_samples": 4000,
      "random_state": 0
    },
    "lof": {
      "n_neighbors": 20,
      "max_train_samples": 6000,
      "n_jobs": 1,
      "random_state": 0
    },
    "hbos": {
      "n_bins": 10
    },
    "elliptic_envelope": {
      "contamination": 0.05,
      "max_train_samples": 6000,
      "random_state": 0
    },
    "autoencoder": {
      "hidden_layer_sizes": [
        8,
        4,
        8
      ],
      "max_iter": 80,
      "max_train_samples": 6000,
      "random_state": 0
    }
  },
  "bootstrap": {
    "n_boot": 400,
    "block_size": 50,
    "seed": 0,
    "ci": 0.95
  },
  "representations": [
    "raw",
    "residual"
  ],
  "cache_dir": ".cache/phase_a",
  "output_dir": "experiments",
  "tables_dir": "tables",
  "figures_dir": "figures"
}